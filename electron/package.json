{
  "name": "taste-and-trace-desktop",
  "version": "0.1.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.hyrican.tasteandtrace",
    "productName": "Taste & Trace",
    "directories": {
      "output": "../dist_electron"
    },
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "milleran41",
        "repo": "taste-and-trace-download"
      }
    ],
    "files": [
      "main.js",
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../public/icons",
        "to": "icons"
      }
    ],
    "win": {
      "icon": "../public/icons/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "../public/icons/icon-512.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "../public/icons/icon-512.png",
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taste & Trace",
      "uninstallDisplayName": "Taste & Trace"
    }
  }
}
